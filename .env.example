# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.

# --- Supabase (public / browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Supabase (server only — never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- AI providers (server only) ---
# Option A (recommended if you cannot add a Vercel card): free Groq key
# https://console.groq.com → API Keys
GROQ_API_KEY=

# Option B: Vercel AI Gateway (requires a card on file to unlock free $5 credits)
# AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# Optional model override
# Groq example: llama-3.1-8b-instant
# Gateway example: meta/llama-3.1-8b
# AI_EXPLAIN_MODEL=

# Sister product (Digital)
NEXT_PUBLIC_DIGITAL_URL=https://wisdomtower.tech
