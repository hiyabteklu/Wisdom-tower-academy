# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.

# --- Supabase (public / browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Supabase (server only — never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Appwrite (Grades 9–12 file storage) ---
# Console → Project settings / Storage
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
# Bucket ID from Storage → bucket → Settings (e.g. 6aa99732001b5373c639)
APPWRITE_BUCKET_ID=your_bucket_id
# Optional public alias of the same bucket id
# NEXT_PUBLIC_APPWRITE_BUCKET_ID=your_bucket_id
# API key with storage write (server upload only)
APPWRITE_API_KEY=your_api_key

# --- AI providers (server only) ---
# Option A (recommended if you cannot add a Vercel card): free Groq key
# https://console.groq.com → API Keys
GROQ_API_KEY=

# Option B: Vercel AI Gateway (requires a card on file to unlock free $5 credits)
# AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# Optional model override
# Groq example: llama-3.1-8b-instant
# Gateway example: meta/llama-3.1-8b
# AI_EXPLAIN_MODEL=

# Sister product (Digital)
NEXT_PUBLIC_DIGITAL_URL=https://wisdomtower.tech

# --- Verify.ET (Ethiopian bank / Telebirr payment verification) ---
# Get a key at https://verify.et — keep this server-side only
VERIFY_ET_API_KEY=
# Optional overrides
# VERIFY_ET_BASE_URL=https://verify.et
# Last 8 digits of CBE account 1000665070654
# VERIFY_ET_CBE_SUFFIX=65070654
# Last 5 digits of Abyssinia account 211958545
# VERIFY_ET_BOA_SUFFIX=958545
# How long to wait for inline result (ms, max ~15000)
# VERIFY_ET_WAIT_MS=8000
