# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# --- Supabase (public / browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Supabase (server only — never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Vercel AI Gateway (server only) ---
# Create at: Vercel Dashboard → AI Gateway → API Keys
# Free tier: $5 credits / month
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Optional: override model (default is a cheap free-tier-friendly model)
# AI_EXPLAIN_MODEL=openai/gpt-oss-20b
